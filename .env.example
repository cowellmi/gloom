# Nix handles build tools.
GOSUMDB=off
GOTOOLCHAIN=local

# MCU device. Example: /dev/cu.usbmodem*, /dev/ttyACM*
GLOOM_PORT= 

# Serial adapter device. Default: $GLOOM_PORT.
# GLOOM_SERIAL =

# TinyGo build target. Available: feather-m0
GLOOM_TARGET=feather-m0

# TinyGo build -tags. Separate tags with commas.
# no_lfn disables lfn support which restricts to 
# 8.3 file format on fatfs (for SD cards).
GLOOM_TAGS=no_lfn
